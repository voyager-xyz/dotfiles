alias dsu="devbox services up"
alias gw="./gradlew"
alias qr="./bin/quiet_rspec"
alias d="devbox"

export PATH="$HOME/.local/bin:$PATH"

# hotel. Sourced once here -- this file used to source it twice, and .zshrc
# sourced it a third time.
[ -f "${HOME}/.config/hotel/config.zsh" ] && source "${HOME}/.config/hotel/config.zsh"

# granted / .cargo/env intentionally omitted: both already load from .zshenv,
# which runs first. The copy that used to live here also had a typo --
# "${HOME}.granted/..." (missing slash) -- so it pushed a nonexistent
# directory onto fpath for compinit to stat on every startup.
