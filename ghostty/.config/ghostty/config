fullscreen = false
maximize = true
shell-integration = zsh
keybind = ctrl+tab=unbind

## Window
window-decoration = true
mouse-hide-while-typing = true
window-padding-x = 30
window-padding-y = 50
macos-window-shadow = false

# Keep redraws aligned to the refresh interval. Setting this false is the only
# real input-latency lever on macOS, but Ghostty documents it as risking kernel
# panics on 14.4+ and misbehaving on external/DisplayLink displays -- and this
# panel is a scaled-HiDPI 4K (see the alpha-blending note below), so the risk
# is live here. Left on deliberately; flip it only to test latency.
window-vsync = true

## Clipboard
clipboard-read = "allow"
clipboard-paste-protection = false

## Theme
# Chosen for long-session eye comfort on this display. Measured against the
# previous Molokai: background lifted off near-black (L* 16.2 vs 5.5) and
# accent chroma roughly halved (mean 38 / max 49, vs 65 / 124). High-chroma
# accents on a near-black background are what cause halation and colour
# fringing, and the scaled-HiDPI downsample on this panel amplifies it.
# All 12 ANSI accents clear 4.5:1 here; Molokai had 2 that did not.
# Matches the tmux and nvim themes (both catppuccin-macchiato).
theme = Catppuccin Macchiato
font-family = FiraMono Nerd Font Mono
font-size = 18

adjust-cell-width = 3%
adjust-cell-height = 20%

# Blend text in linear space so coloured glyphs don't pick up a dark fringe,
# with the correction step that keeps weight identical to `native` (plain
# `linear` would thin the text). Matters here because macOS renders a
# 6016x3384 framebuffer and downsamples it to the panel's native 4K, which
# resamples every glyph edge.
alpha-blending = linear-corrected

## Terminal Capabilities
# Enable Option key as Alt for proper modifier key support
macos-option-as-alt = true

## Performance
# Scrollback lives in tmux, which owns its own history, so Ghostty's default
# 10MB per surface is memory held for a buffer that is never scrolled. 1MB is
# enough for the occasional bare (non-tmux) surface.
scrollback-limit = 1000000

# No inline-image protocol use in this setup (no image.nvim, timg, chafa), so
# the 320MB-per-surface default is pure reservation. Raise this again if an
# image plugin lands.
image-storage-limit = 16000000

# Don't render the dimensions overlay on every resize.
resize-overlay = never

# Skip window-state restore work at launch. Cost: no window restore after a
# force-quit.
window-save-state = never
custom-shader = /Users/jarrod.folino/.config/ghostty/shaders/ripple_rectangle_cursor.glsl
